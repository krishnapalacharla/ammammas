<article class="product-card"><a class="product-photo" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 450, 700' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a><button class="save-product" data-save="{{ product.handle }}" aria-label="Save {{ product.title | escape }}" aria-pressed="false">{% render 'icon', name: 'heart' %}</button><div class="product-meta"><small>{{ product.type | escape }}</small><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><div class="product-price">{{ product.price | money }}</div></div><a class="button" href="{{ product.url }}">{% if product.available %}Choose options{% else %}View product{% endif %}</a></article>