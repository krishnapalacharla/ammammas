{% assign studio_asset = '' %}{% assign studio_title = product.title %}{% assign studio_pack = '' %}{% assign studio_scale = 1 %}{% case product.handle %}{% when 'mango-pickle-300g' %}{% assign studio_asset = 'studio-mango.jpg' %}{% assign studio_title = 'Mango Pickle' %}{% assign studio_pack = '250 g' %}{% assign studio_scale = 0.99 %}{% when 'lemon-pickle-300g' %}{% assign studio_asset = 'studio-lemon.jpg' %}{% assign studio_title = 'Lemon Pickle' %}{% assign studio_pack = '250 g' %}{% assign studio_scale = 0.99 %}{% when 'cow-ghee' %}{% assign studio_asset = 'studio-ghee-250.jpg' %}{% assign studio_title = 'Cow Ghee' %}{% assign studio_pack = '250 ml' %}{% assign studio_scale = 0.99 %}{% when 'cow-ghee-500ml' %}{% assign studio_asset = 'studio-ghee-500.jpg' %}{% assign studio_title = 'Cow Ghee' %}{% assign studio_pack = '500 ml' %}{% assign studio_scale = 0.92 %}{% when 'murukulu' %}{% assign studio_asset = 'studio-murukulu.jpg' %}{% assign studio_title = 'Kara Kara Murukulu' %}{% assign studio_pack = '' %}{% assign studio_scale = 0.96 %}{% when 'jantikalu' %}{% assign studio_asset = 'studio-janthikalu.jpg' %}{% assign studio_title = 'Janthikalu' %}{% assign studio_pack = '' %}{% assign studio_scale = 0.91 %}{% when 'ammammas-nalla-karam' %}{% assign studio_asset = 'studio-karam.jpg' %}{% assign studio_title = 'Nalla Karam' %}{% assign studio_pack = '250 g' %}{% assign studio_scale = 0.92 %}{% when 'dhaniya-powder' %}{% assign studio_asset = 'studio-coriander.jpg' %}{% assign studio_title = 'Coriander Powder' %}{% assign studio_pack = '250 g' %}{% assign studio_scale = 0.92 %}{% when 'ammammas-ring-fryums' %}{% assign studio_asset = 'studio-ring-fryums.jpg' %}{% assign studio_title = 'Ring Fryums' %}{% assign studio_pack = '' %}{% assign studio_scale = 0.95 %}{% when 'ammammas-tube-fryums' %}{% assign studio_asset = 'studio-tube-fryums.jpg' %}{% assign studio_title = 'Tube Fryums' %}{% assign studio_pack = '' %}{% assign studio_scale = 0.84 %}{% when 'ammammas-crispy-triangle-frym' %}{% assign studio_asset = 'studio-triangle-fryums.jpg' %}{% assign studio_title = 'Crispy Triangle Fryums' %}{% assign studio_pack = '' %}{% assign studio_scale = 0.95 %}{% when 'cauliflower-pickle' %}{% assign studio_asset = 'studio-cauliflower.jpg' %}{% assign studio_title = 'Cauliflower Pickle' %}{% assign studio_pack = '300 g' %}{% assign studio_scale = 0.99 %}{% endcase %}<article class="product-card pantry-card {% if studio_asset != blank %}studio-card{% endif %}" style="--studio-scale:{{ studio_scale }}" data-reveal><div class="pantry-picture"><a class="product-photo" href="{{ product.url }}">{% if studio_asset != blank %}<img src="{{ studio_asset | asset_url }}" alt="{{ studio_title | escape }} {{ studio_pack | escape }}" width="1254" height="1254" loading="lazy">{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a><button class="save-product" data-save="{{ product.handle }}" aria-label="Save {{ studio_title | escape }}" aria-pressed="false">{% render 'icon', name: 'heart' %}</button></div><div class="pantry-label"><span class="pantry-category">{{ product.type | escape }}</span><h3><a href="{{ product.url }}">{{ studio_title | escape }}</a></h3>{% if studio_asset != blank %}<span class="studio-pack">{{ studio_pack | escape }}</span>{% endif %}<div class="pantry-card-bottom"><span class="pantry-price">{{ product.price | money }}</span><a class="pantry-shop" href="{{ product.url }}">{% if product.available %}Choose options{% else %}View product{% endif %}</a></div></div></article>