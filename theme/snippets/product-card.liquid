<article class="product-card pantry-card" data-reveal><div class="pantry-picture"><a class="product-photo" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800' }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}</a><button class="save-product" data-save="{{ product.handle }}" aria-label="Save {{ product.title | escape }}" aria-pressed="false">{% render 'icon', name: 'heart' %}</button></div><div class="pantry-label"><span class="pantry-category">{{ product.type | escape }}</span><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><div class="pantry-card-bottom"><span class="pantry-price">{{ product.price | money }}</span><a class="pantry-shop" href="{{ product.url }}">{% if product.available %}Choose options{% else %}View product{% endif %}</a></div></div></article>