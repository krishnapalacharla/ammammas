<article class="recipe-detail recipe-live-article"><div class="container recipe-back"><a class="text-link" href="{{ blog.url }}">← All recipes</a></div><header class="container recipe-detail-hero"><div class="recipe-detail-copy"><span class="eyebrow">From our kitchen</span><h1>{{ article.title | escape }}</h1><div>{{ article.excerpt }}</div><div class="recipe-actions"><a class="button" href="#recipe-method">Let’s get cooking</a><button type="button" class="text-link" data-print-recipe>Print recipe</button></div></div><div class="recipe-detail-photo">{% if article.image %}{{ article.image | image_url: width: 1400 | image_tag: loading: 'eager' }}{% else %}<span class="recipe-drawn-photo"><img src="{{ 'recipe-cooking.svg' | asset_url }}" alt=""></span>{% endif %}</div></header><div id="recipe-method" class="container recipe-article-body">{{ article.content }}</div></article>
{% schema %}
{"name": "Recipe detail", "settings": []}
{% endschema %}