<div class="announcement">{{ section.settings.announcement | escape }}</div><header class="site-header"><div class="container header-inner"><a href="{{ routes.root_url }}" aria-label="Home"><img class="brand-logo" src="{{ 'ammammas-logo.svg' | asset_url }}" width="218" height="97" alt="{{ shop.name | escape }}"></a><nav class="main-nav" aria-label="Main navigation">{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}<details class="nav-shop"><summary>Shop the kitchen</summary><div><a href="{{ routes.all_products_collection_url }}">All Products</a>{% assign category_handles = section.settings.categories | split: ',' %}{% for handle in category_handles %}{% assign clean_handle = handle | strip %}{% assign category = collections[clean_handle] %}{% if category != blank %}<a href="{{ category.url }}">{{ category.title | escape }}</a>{% endif %}{% endfor %}</div></details><a href="/pages/about">Our Story</a><a href="/blogs/recipes">Recipes</a><a href="/pages/contact">Contact</a>{% endif %}</nav><div class="header-tools"><a href="{{ routes.search_url }}" aria-label="Search">{% render 'icon', name: 'search' %}</a><a href="/pages/wishlist" aria-label="Wishlist">{% render 'icon', name: 'heart' %}</a><a href="{{ routes.cart_url }}" aria-label="Shopping bag">{% render 'icon', name: 'bag' %}<span class="bag-count">{{ cart.item_count }}</span></a><button class="mobile-toggle" data-mobile-toggle aria-label="Open menu" aria-expanded="false">{% render 'icon', name: 'menu' %}</button></div></div><nav class="mobile-nav" aria-label="Mobile navigation"><a href="{{ routes.all_products_collection_url }}">All Products</a><a href="/pages/about">Our Story</a><a href="/blogs/recipes">Recipes</a><a href="/pages/contact">Contact</a>{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% endif %}</nav></header>
{% schema %}
{"name": "Header", "settings": [{"type": "text", "id": "announcement", "label": "Announcement", "default": "Authentic Indian foods. Made with love since 2019."}, {"type": "link_list", "id": "menu", "label": "Main menu"}, {"type": "text", "id": "categories", "label": "Collection handles", "default": "pickles,spices,ready-to-cook,ghee,snacks,fryum-factory,retro"}]}
{% endschema %}