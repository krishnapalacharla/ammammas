{% assign studio_asset = '' %}{% assign studio_title = product.title %}{% assign studio_pack = '' %}{% assign studio_scale = 1 %}{% case product.handle %}{% when 'mango-pickle-300g' %}{% assign studio_asset = 'studio-mango.jpg' %}{% assign studio_title = 'Mango Pickle' %}{% assign studio_pack = '250 g' %}{% assign studio_scale = 0.99 %}{% when 'lemon-pickle-300g' %}{% assign studio_asset = 'studio-lemon.jpg' %}{% assign studio_title = 'Lemon Pickle' %}{% assign studio_pack = '250 g' %}{% assign studio_scale = 0.99 %}{% when 'cow-ghee' %}{% assign studio_asset = 'studio-ghee-250.jpg' %}{% assign studio_title = 'Cow Ghee' %}{% assign studio_pack = '250 ml' %}{% assign studio_scale = 0.99 %}{% when 'cow-ghee-500ml' %}{% assign studio_asset = 'studio-ghee-500.jpg' %}{% assign studio_title = 'Cow Ghee' %}{% assign studio_pack = '500 ml' %}{% assign studio_scale = 0.92 %}{% when 'murukulu' %}{% assign studio_asset = 'studio-murukulu.jpg' %}{% assign studio_title = 'Kara Kara Murukulu' %}{% assign studio_pack = '' %}{% assign studio_scale = 0.96 %}{% when 'jantikalu' %}{% assign studio_asset = 'studio-janthikalu.jpg' %}{% assign studio_title = 'Janthikalu' %}{% assign studio_pack = '' %}{% assign studio_scale = 0.91 %}{% when 'ammammas-nalla-karam' %}{% assign studio_asset = 'studio-karam.jpg' %}{% assign studio_title = 'Nalla Karam' %}{% assign studio_pack = '250 g' %}{% assign studio_scale = 0.92 %}{% when 'dhaniya-powder' %}{% assign studio_asset = 'studio-coriander.jpg' %}{% assign studio_title = 'Coriander Powder' %}{% assign studio_pack = '250 g' %}{% assign studio_scale = 0.92 %}{% when 'ammammas-ring-fryums' %}{% assign studio_asset = 'studio-ring-fryums.jpg' %}{% assign studio_title = 'Ring Fryums' %}{% assign studio_pack = '' %}{% assign studio_scale = 0.95 %}{% when 'ammammas-tube-fryums' %}{% assign studio_asset = 'studio-tube-fryums.jpg' %}{% assign studio_title = 'Tube Fryums' %}{% assign studio_pack = '' %}{% assign studio_scale = 0.84 %}{% when 'ammammas-crispy-triangle-frym' %}{% assign studio_asset = 'studio-triangle-fryums.jpg' %}{% assign studio_title = 'Crispy Triangle Fryums' %}{% assign studio_pack = '' %}{% assign studio_scale = 0.95 %}{% when 'cauliflower-pickle' %}{% assign studio_asset = 'studio-cauliflower.jpg' %}{% assign studio_title = 'Cauliflower Pickle' %}{% assign studio_pack = '300 g' %}{% assign studio_scale = 0.99 %}{% endcase %}<div class="container breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.all_products_collection_url }}">Products</a> / {{ product.title | escape }}</div><section class="container product-detail"><div class="product-gallery">{% if studio_asset != blank %}<img id="main-product-photo" class="main-photo" src="{{ studio_asset | asset_url }}" alt="{{ studio_title | escape }} {{ studio_pack | escape }} studio shot" width="1254" height="1254" fetchpriority="high">{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: class: 'main-photo', id: 'main-product-photo', loading: 'eager' }}{% endif %}<div class="gallery-thumbs">{% if studio_asset != blank %}<button type="button" data-photo="{{ studio_asset | asset_url }}" aria-label="View studio shot" aria-pressed="true"><img src="{{ studio_asset | asset_url }}" alt="{{ studio_title | escape }} studio shot" width="80" height="80"></button>{% endif %}{% for image in product.images %}<button type="button" data-photo="{{ image | image_url: width: 1400 }}" aria-label="View original image {{ forloop.index }}" aria-pressed="{% if studio_asset == blank and forloop.first %}true{% else %}false{% endif %}">{{ image | image_url: width: 150 | image_tag: loading: 'lazy' }}</button>{% endfor %}</div></div><div class="detail-copy"><span class="eyebrow">{{ product.type | escape }}</span><h1>{{ product.title | escape }}</h1><p class="detail-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</p><div>{{ product.description }}</div>{% form 'product', product %}<label for="ProductVariant-{{ section.id }}">Size / option</label><select id="ProductVariant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Out of Stock{% endunless %}</option>{% endfor %}</select><div class="purchase-row"><label class="sr-only" for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" name="quantity" type="number" value="1" min="1"><button class="button" type="submit" name="add" data-product-submit {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Add to Cart{% else %}Out of Stock{% endif %}</button></div>{{ form.errors | default_errors }}{% endform %}<button data-save="{{ product.handle }}" aria-pressed="false">Save to wishlist</button></div></section><script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{"name": "Product", "settings": []}
{% endschema %}