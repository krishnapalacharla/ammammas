<div class="container breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.all_products_collection_url }}">Products</a> / {{ product.title | escape }}</div><section class="container product-detail"><div class="product-gallery">{% if product.featured_image %}{{ product.featured_image | image_url: width: 1400 | image_tag: class: 'main-photo', id: 'main-product-photo', loading: 'eager' }}{% endif %}<div class="gallery-thumbs">{% for image in product.images %}<button data-photo="{{ image | image_url: width: 1400 }}" aria-label="View image {{ forloop.index }}">{{ image | image_url: width: 150 | image_tag: loading: 'lazy' }}</button>{% endfor %}</div></div><div class="detail-copy"><span class="eyebrow">{{ product.type | escape }}</span><h1>{{ product.title | escape }}</h1><p class="detail-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</p><div>{{ product.description }}</div>{% form 'product', product %}<label for="ProductVariant-{{ section.id }}">Size / option</label><select id="ProductVariant-{{ section.id }}" name="id" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Out of Stock{% endunless %}</option>{% endfor %}</select><div class="purchase-row"><label class="sr-only" for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" name="quantity" type="number" value="1" min="1"><button class="button" type="submit" name="add" data-product-submit {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Add to Cart{% else %}Out of Stock{% endif %}</button></div>{{ form.errors | default_errors }}{% endform %}<button data-save="{{ product.handle }}" aria-pressed="false">Save to wishlist</button></div></section><script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{"name": "Product", "settings": []}
{% endschema %}