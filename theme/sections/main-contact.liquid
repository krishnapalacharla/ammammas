<section class="container content-page"><h1>Contact Us</h1><p>Have a question, suggestion, or just want to say hello? We'd love to hear from you.</p>{% form 'contact' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">Thank you. Your message has been sent.</p>{% endif %}<label for="ContactName">Name</label><input id="ContactName" name="contact[name]" autocomplete="name" required><label for="ContactEmail">Email</label><input id="ContactEmail" name="contact[email]" type="email" autocomplete="email" required><label for="ContactSubject">Subject</label><input id="ContactSubject" name="contact[subject]"><label for="ContactBody">Message</label><textarea id="ContactBody" name="contact[body]" rows="6" required></textarea><button class="button">Send Message</button>{% endform %}</section>
{% schema %}
{"name": "Contact form", "settings": []}
{% endschema %}