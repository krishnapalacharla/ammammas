<section class="container content-page"><h1>Your bag</h1>{% if cart.empty? %}<p>Your bag is empty.</p><a class="button" href="{{ routes.all_products_collection_url }}">Shop All Products</a>{% else %}{% form 'cart', cart %}{% for item in cart.items %}<div class="cart-line">{{ item.image | image_url: width: 150 | image_tag: loading: 'lazy' }}<div><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3><p>{{ item.variant.title | escape }} · {{ item.final_line_price | money }}</p><label for="Quantity-{{ item.key }}">Quantity</label><input id="Quantity-{{ item.key }}" name="updates[]" type="number" value="{{ item.quantity }}" min="0"></div><a href="{{ item.url_to_remove }}">Remove</a></div>{% endfor %}<div class="cart-total"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div><p>Shipping and taxes calculated at checkout.</p><button type="submit" name="update">Update bag</button><button class="button" type="submit" name="checkout">Checkout</button>{% endform %}{% endif %}</section>
{% schema %}
{"name": "Cart", "settings": []}
{% endschema %}