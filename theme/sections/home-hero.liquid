<section class="new-hero"><div class="hero-copy"><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h1>{{ section.settings.heading | escape | newline_to_br }}</h1><p>{{ section.settings.description | escape }}</p><div class="hero-actions"><a class="button" href="{{ section.settings.link | default: '/collections/pickles' }}">Shop Pickles</a><a class="text-link" href="{{ routes.all_products_collection_url }}">View All Products</a></div></div><div class="hero-art">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '480, 768, 1200, 1600' }}{% else %}<img src="{{ 'ref-1ca76b142d6c.jpg' | asset_url }}" width="1200" height="1200" alt="Authentic Andhra Pickles" fetchpriority="high">{% endif %}<div class="hero-stamp"><strong>Made<br>with love.</strong><span>Since 2019</span></div></div></section><div class="proof-strip"><span><strong>12</strong> States Available</span><span><strong>40+</strong> Cities Served</span><span><strong>10 lac+</strong> Happy Customers</span></div>
{% schema %}
{"name": "Heritage hero", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Arrivals This Week"}, {"type": "textarea", "id": "heading", "label": "Heading", "default": "Authentic\nAndhra\nPickles."}, {"type": "textarea", "id": "description", "label": "Description", "default": "Hand-pounded spices, Premium quality oils, and recipes passed down through generations. No preservatives, just pure taste."}, {"type": "image_picker", "id": "image", "label": "Hero image"}, {"type": "url", "id": "link", "label": "Shop link"}]}
{% endschema %}