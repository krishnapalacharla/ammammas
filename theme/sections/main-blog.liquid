{% if blog.articles_count > 0 %}<div class="recipe-index"><section class="container recipe-index-hero"><div><span class="eyebrow">From our kitchen</span><h1>{{ blog.title | escape }}</h1><p>Quick breakfasts, comforting lunches and weekend favourites.</p></div><span class="art-wash recipe-hero-art"><img src="{{ 'recipe-cooking.svg' | asset_url }}" alt=""></span></section><section class="container recipe-shelf"><div class="recipe-filter-row"><nav class="recipe-filters" aria-label="Filter recipes"><button type="button" data-recipe-filter="All" aria-pressed="true">All recipes</button>{% for tag in blog.all_tags %}<button type="button" data-recipe-filter="{{ tag | escape }}" aria-pressed="false">{{ tag | escape }}</button>{% endfor %}</nav><span class="recipe-count" role="status" aria-live="polite"></span></div>{% paginate blog.articles by 24 %}<div class="recipe-card-grid">{% for article in blog.articles %}<article class="recipe-card" data-recipe-tags="{{ article.tags | join: '|' | escape }}"><a class="recipe-card-photo" href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}{% else %}<span class="recipe-drawn-photo"><img src="{{ 'recipe-cooking.svg' | asset_url }}" alt=""></span>{% endif %}</a><div class="recipe-card-copy"><div class="recipe-card-tags"><span>{{ article.tags | first | escape }}</span></div><h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><div>{{ article.excerpt }}</div><a class="text-link" href="{{ article.url }}">Let’s make it ↗</a></div></article>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section></div>{% else %}<div class="recipe-index"><section class="container recipe-index-hero"><div><span class="eyebrow">From our kitchen</span><h1>A little stirring.<br>A lot of <em>joy.</em></h1><p>Quick breakfasts, comforting lunches and weekend favourites. Make a little room for something delicious.</p><a class="text-link" href="#recipe-shelf">Find y