<section class="heritage-newsletter"><div class="container"><span class="art-wash"><img src="{{ 'spice-sprig.svg' | asset_url }}" alt=""></span><div><p class="newsletter-quote">“One recipe a week, from my kitchen to yours.”</p><h2>Stay Updated</h2><p>Get recipes, offers & new product alerts straight to your inbox</p>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="sr-only" for="NewsletterEmail">Email address</label><input id="NewsletterEmail" name="contact[email]" type="email" placeholder="Your email address" required><button class="button" type="submit">Subscribe</button>{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p>Thank you for subscribing.</p>{% endif %}{% endform %}<small>No spam, unsubscribe anytime. By subscribing you agree to our <a href="/pages/privacy-policy">Privacy Policy</a>.</small></div><span class="art-wash"><img src="{{ 'tiffin.svg' | asset_url }}" alt=""></span></div></section>
{% schema %}
{"name": "Newsletter", "settings": []}
{% endschema %}