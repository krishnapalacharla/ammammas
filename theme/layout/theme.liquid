<!doctype html>
<html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title | escape }}{% unless page_title contains shop.name %} | {{ shop.name | escape }}{% endunless %}</title>{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}{{ content_for_header }}{{ 'reference-structure.css' | asset_url | stylesheet_tag }}{{ 'theme.css' | asset_url | stylesheet_tag }}{{ 'heritage.css' | asset_url | stylesheet_tag }}{{ 'home-refinements.css' | asset_url | stylesheet_tag }}<style>:root{--red:{{ settings.brand_red | default: '#e21331' }};--cream:{{ settings.brand_cream | default: '#fdf0d6' }};--brown:{{ settings.brand_brown | default: '#77290d' }};}</style><script src="{{ 'heritage.js' | asset_url }}" defer></script><script src="{{ 'theme.js' | asset_url }}" defer></script></head><body><a class="skip-link" href="#MainContent">Skip to content</a>{% section 'header' %}<main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>{% section 'footer' %}<div id="status" role="status" aria-live="polite"></div></body></html>